# Copy file nay thanh .env va dien gia tri that, KHONG commit .env vao git.
# Chi dung 2 file: .env (that, gitignored) va .env.example (mau, nay).
# Dev local va production dung CUNG mau nay, chi khac gia tri - xem ghi chu
# "PRODUCTION" o tung muc. Secret production PHAI sinh MOI, khong dung lai cua dev.

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sinh bang: openssl rand -base64 32
JWT_SECRET= SuperLongSecretKeyHereAtLeast32CharactersMakeItRandom2026

# Sinh bang: openssl rand -base64 32  (dung cho AES-256-GCM)
CRYPTO_SECRET_KEY=

# ---- Project (quy chuan deploy: [PP][SS], PP=82) ----
PROJECT_NAME=noted
PROJECT_CODE=82
WEB_PORT=8200
API_PORT=8210
REDIS_DB=2

# Backend chay port 8210 (cau hinh qua SERVER_PORT, xem docker-compose.yml)
SERVER_PORT=8210

# ---- Database ----
# Gia dinh mysql8 la container CO SAN, da noi vao network ngoai "shared-db-network"
# tu truoc (xem README muc 10) - docker-compose.yml tu ghep DB_NAME/DB_USER/
# DB_PASSWORD duoi day thanh DB_URL tro toi host "mysql8" qua DNS noi bo Docker.
DB_NAME=note_text
DB_USER=root
DB_PASSWORD=

# ---- CORS + redirect sau khi dang nhap Google ----
# Co 2 kich ban trien khai, chon dung 1 gia tri khop thuc te:
#
# (A) Dev local, chay `pnpm dev` truc tiep (khong qua Docker/nginx):
#     FRONTEND_REDIRECT_URL=http://localhost:8445/oauth/callback
#     ALLOWED_ORIGINS=http://localhost:8445
#
# (B) Docker + nginx reverse proxy (xem repo frontend noteText, nginx port 8200):
#     nginx la nguoi DUY NHAT trinh duyet noi chuyen truc tiep, nen ORIGIN
#     that su la port 8200, khong phai 8445/8210 nua:
#     FRONTEND_REDIRECT_URL=http://localhost:8200/oauth/callback
#     ALLOWED_ORIGINS=http://localhost:8210
#
# (C) PRODUCTION qua Cloudflare Tunnel (cloudflared ingress):
#       noted.thongtinchinhhieu.site      -> http://localhost:8200  (noted-web)
#       noted-api.thongtinchinhhieu.site  -> http://localhost:8210  (noted-api)
#     Tu 2026-10-18 frontend goi THANG backend qua noted-api.* (build web voi
#     VITE_API_BASE_URL=https://noted-api.thongtinchinhhieu.site), khong con di
#     qua nginx proxy. Hai domain cung "site" (cung thongtinchinhhieu.site) nen
#     cookie refresh_token van gui duoc, nhung la CROSS-ORIGIN nen can CORS
#     allow-credentials: ALLOWED_ORIGINS PHAI la origin cua WEB.
#     Callback cua Google tro vao BACKEND (phai dang ky trong Cloud Console):
#       https://noted-api.thongtinchinhhieu.site/login/oauth2/code/google
#       https://noted-api.thongtinchinhhieu.site/api/drive/callback
#     Con URL ve FRONTEND van la domain web:
#     FRONTEND_REDIRECT_URL=https://noted.thongtinchinhhieu.site/oauth/callback
#     ALLOWED_ORIGINS=https://noted.thongtinchinhhieu.site
#     DRIVE_FRONTEND_CALLBACK_URL=https://noted.thongtinchinhhieu.site/drive/callback
#     DRIVE_REDIRECT_URI=https://noted-api.thongtinchinhhieu.site/api/drive/callback
#     REFRESH_COOKIE_SECURE=true
FRONTEND_REDIRECT_URL=http://localhost:8445/oauth/callback
ALLOWED_ORIGINS=http://localhost:8445

STORAGE_BASE_PATH=/data/noted/notes

# So ngay giu lai note da xoa (soft-delete) truoc khi bi XOA VINH VIEN
# (purge job, SEC-12) - het moc nay khong con kha nang khoi phuc
NOTES_PURGE_AFTER_DAYS=30

# Gioi han goi PATCH /api/notes/{id}/content (auto-save, SEC-13) - THEO USER.
# Mac dinh 5 request bung + 1 token moi 500ms la du rong rai cho FE (debounce
# 1.3s), chi chan duoc client loi/spam qua nhanh
RATE_LIMIT_AUTOSAVE_CAPACITY=5
RATE_LIMIT_AUTOSAVE_REFILL_MS=500

# PRODUCTION: dat 86400000 (1 ngay); dev co the rut ngan (vd 60000) de test nhanh
NOTES_PURGE_JOB_FIXED_DELAY_MS=86400000

# false khi dev local (http), BAT BUOC true khi production qua https
REFRESH_COOKIE_SECURE=false

# dev = nap them application-dev.yml, prod = application-prod.yml
# PRODUCTION: prod (khi do FRONTEND_REDIRECT_URL/ALLOWED_ORIGINS/DRIVE_* phai dung
# domain that, khong de localhost)
SPRING_PROFILES_ACTIVE=dev

# ---- Luong ket noi Google Drive (SEC-09) ----
# PHAI khop chinh xac voi "Authorized redirect URIs" da khai bao trong
# Google Cloud Console, neu khong Google se tra loi "redirect_uri_mismatch"
DRIVE_REDIRECT_URI=http://localhost:8210/api/drive/callback
DRIVE_FRONTEND_CALLBACK_URL=http://localhost:8445/drive/callback
